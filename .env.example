# Build-time public settings (rebuild after changes)
NEXT_PUBLIC_SITE_URL=https://your-verified-domain.example
NEXT_PUBLIC_CONTACT_EMAIL=stahltechbiz@gmail.com
NEXT_PUBLIC_CONTACT_PHONE=+92 333 86 00 603
NEXT_PUBLIC_CONTACT_ADDRESS=Sialkot, Punjab, Pakistan
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_SURGICAL_URL=
NEXT_PUBLIC_LEATHER_URL=

# Server-only runtime settings. Never prefix these with NEXT_PUBLIC_.
# Create the key at https://resend.com/api-keys.
RESEND_API_KEY=
# Must be a verified Resend sender/domain, e.g. "STAHLTECH <enquiries@your-domain.com>".
# Before domain verification you can use "STAHLTECH <onboarding@resend.dev>", but
# Resend then only delivers to the email address that owns the Resend account.
ENQUIRY_FROM=
# Business inbox that receives enquiries. Comma-separate to add more recipients.
ENQUIRY_TO=stahltechbiz@gmail.com
